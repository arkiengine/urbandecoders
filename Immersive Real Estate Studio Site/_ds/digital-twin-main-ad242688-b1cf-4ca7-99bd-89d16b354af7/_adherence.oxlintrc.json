{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/cards/**",
              "components/code/**",
              "components/forms/**",
              "components/navigation/**",
              "components/signature/**",
              "ui_kits/marketing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Newsreader|Play|Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Newsreader, Play, Inter, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='BadgePill'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<BadgePill> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='BadgePill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|brand|ghost)$/]",
        "message": "<BadgePill> tone must be one of 'neutral' | 'brand' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|iconLeft|iconRight|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, iconLeft, iconRight, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|brand|ghost|outline)$/]",
        "message": "<Button> variant must be one of 'primary' | 'brand' | 'ghost' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm|lg)$/]",
        "message": "<Button> size must be one of 'md' | 'sm' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeWindow'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|activeTab|onTabChange|title|children|key|ref|className|style|children)$/]",
        "message": "<CodeWindow> doesn't accept that prop. Declared props: tabs, activeTab, onTabChange, title, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContributorAvatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|initials|size|key|ref|className|style|children)$/]",
        "message": "<ContributorAvatar> doesn't accept that prop. Declared props: src, initials, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmailMockup'] > JSXAttribute > JSXIdentifier[name!=/^(?:from|subject|preview|dark|children|key|ref|className|style|children)$/]",
        "message": "<EmailMockup> doesn't accept that prop. Declared props: from, subject, preview, dark, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|eyebrow|icon|bordered|glow|highlight|children|key|ref|className|style|children)$/]",
        "message": "<FeatureCard> doesn't accept that prop. Declared props: title, eyebrow, icon, bordered, glow, highlight, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|items|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: title, items."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|height|assetBase|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, height, assetBase."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:lockup|badge|monogram|wordmark)$/]",
        "message": "<Logo> variant must be one of 'lockup' | 'badge' | 'monogram' | 'wordmark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:links|active|cta|assetBase|key|ref|className|style|children)$/]",
        "message": "<NavBar> doesn't accept that prop. Declared props: links, active, cta, assetBase."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingTier'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|price|period|blurb|features|cta|ctaVariant|featured|key|ref|className|style|children)$/]",
        "message": "<PricingTier> doesn't accept that prop. Declared props: name, price, period, blurb, features, cta, ctaVariant, featured."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingTier'] > JSXAttribute[name.name='ctaVariant'] > Literal[value!=/^(?:primary|brand|ghost|outline)$/]",
        "message": "<PricingTier> ctaVariant must be one of 'primary' | 'brand' | 'ghost' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|pulse|key|ref|className|style|children)$/]",
        "message": "<StatusDot> doesn't accept that prop. Declared props: tone, pulse."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:green|yellow|red|blue|brand)$/]",
        "message": "<StatusDot> tone must be one of 'green' | 'yellow' | 'red' | 'blue' | 'brand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|invalid|containerStyle|key|ref|className|style|children)$/]",
        "message": "<TextInput> doesn't accept that prop. Declared props: label, hint, invalid, containerStyle."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
